# Pak Coin Deployment Environment Variables

# Deployer wallet private key (Export from MetaMask: Settings -> Security & Privacy)
# DO NOT COMMIT YOUR REAL PRIVATE KEY TO GITHUB!
PRIVATE_KEY=your_private_key_here_without_0x

# BSCScan API Key for automated contract source code verification
# Get a free key at: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Etherscan API Key (if deploying to Sepolia / Ethereum)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
